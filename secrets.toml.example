# Streamlit Cloud > Manage app > ⋮ > Settings > Secrets. Never put these in GitHub.
# Use ONE of the two options below.

# ---- Option A (recommended): each person signs in to Fabric with their own account ----------------
# App registration: Authentication > "Allow public client flows" = Yes; API permissions (delegated,
# Power BI Service): Workspace.Read.All, Item.ReadWrite.All, Report.Read.All, Dataset.Read.All + admin consent.
# Do NOT add FABRIC_CLIENT_SECRET for this option.
FABRIC_TENANT_ID  = "00000000-0000-0000-0000-000000000000"
FABRIC_CLIENT_ID  = "00000000-0000-0000-0000-000000000000"
LOAD_SAMPLE_DATA  = "true"
DEVELOPER_NAME    = "Vishwa Gajjala"

# ---- Option B: one service principal reads Fabric for everybody -----------------------------------
# FABRIC_TENANT_ID       = "00000000-0000-0000-0000-000000000000"
# FABRIC_CLIENT_ID       = "00000000-0000-0000-0000-000000000000"
# FABRIC_CLIENT_SECRET   = "secret VALUE (not the secret ID)"
# FABRIC_USE_SCANNER_API = "false"

# ---- Who may open the app (optional; needs the [auth] block below) ---------------------------------
# ALLOWED_USERS   = "viswa.g123@gmail.com, colleague@yourcompany.com"
# ALLOWED_DOMAINS = "yourcompany.com"
# [auth]
# redirect_uri  = "https://YOUR-APP-NAME.streamlit.app/oauth2callback"
# cookie_secret = "any-long-random-text-at-least-32-characters"
# [auth.microsoft]
# client_id           = "sign-in app (client) ID"
# client_secret       = "sign-in app secret VALUE"
# server_metadata_url = "https://login.microsoftonline.com/YOUR-TENANT-ID/v2.0/.well-known/openid-configuration"
